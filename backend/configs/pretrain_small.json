    "precision": "auto",
    "gradient_checkpointing": false,
    "log_every": 20,
    "eval_every": 2000,
    "sample_every": 1000,
    "checkpoint_minutes": 30
  },
  "tokenizer": "models/tokenizer/v1",
  "shards": "data/corpus/shards"
}
