DATABASE_URL=sqlite:///./data/sideline.db
# MySQL (see compose.dev.yml): mysql+pymysql://sideline:sideline-dev@127.0.0.1:3306/sideline?charset=utf8mb4
SECRET_KEY=change-me-to-a-long-random-string
TIMEZONE=Asia/Manila
COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
SCHEDULER_ENABLED=true
# Apply database migrations at startup. Set to false when migrations run as a separate step (production).
AUTO_MIGRATE=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
